# --- Cloudbeds auth ---
# Stayable's 8 properties are SEPARATE Cloudbeds accounts, so each has its own
# property-level self-service key. Set one per property, suffixed with the
# Cloudbeds property ID:
#   CLOUDBEDS_API_KEY_2535=cbat_...   # St. Augustine
#   CLOUDBEDS_API_KEY_812=cbat_...    # Jacksonville North
#   ...one per property
# Tool calls route to the key matching their propertyID argument.
CLOUDBEDS_API_KEY_2535=

# Fallback used when a call has no propertyID, or no per-property key matches.
# Handy for single-property setups. Sent as x-api-key.
CLOUDBEDS_API_KEY=
# OAuth 2.0 bearer token (alternative single credential).
CLOUDBEDS_ACCESS_TOKEN=

# API base URL. Default works for most accounts.
CLOUDBEDS_BASE_URL=https://api.cloudbeds.com/api/v1.2

# Enable write tools (payments, notes, status changes). Leave false for read-only.
CLOUDBEDS_ALLOW_WRITES=false

# --- Endpoint auth (REQUIRED) ---
# Shared secret every MCP client must send as `Authorization: Bearer <token>`.
# Generate one: `openssl rand -hex 32`. Without it the server returns 503.
MCP_BEARER_TOKEN=
