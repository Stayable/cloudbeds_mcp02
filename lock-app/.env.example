# Shared Neon DB (same instance as the middleware). Pull from Vercel:
#   vercel env pull .env.local
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth
JWT_SECRET=
MAGIC_LINK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OTP login email (Resend REST API)
RESEND_API_KEY=
# Must be a Resend-verified domain. rentstayable.com is verified, so use e.g.
# "Stayable Locks <admin@rentstayable.com>" (the code fallback if this is unset).
EMAIL_FROM=Stayable Locks <admin@rentstayable.com>

# Cloudbeds per-property API keys (room dropdown / resolver). One key per
# property, keyed by the REAL Cloudbeds propertyID; READ scope is enough.
# A missing key just disables that property's room dropdown ("No Cloudbeds key").
# To fill + push to Vercel, see .env.cloudbeds.local (gitignored copy-paste file).
CLOUDBEDS_API_KEY_206628=   # Jacksonville North (812)
CLOUDBEDS_API_KEY_210987=   # Jacksonville West (6802)
CLOUDBEDS_API_KEY_210986=   # Kissimmee East (2295)
CLOUDBEDS_API_KEY_210969=   # Kissimmee West (5399)
CLOUDBEDS_API_KEY_210972=   # Lakeland (4645)
CLOUDBEDS_API_KEY_210971=   # Orlando OBT (8700)
CLOUDBEDS_API_KEY_208155=   # St. Augustine (2535)
CLOUDBEDS_API_KEY_318197=   # Davenport (44199)
