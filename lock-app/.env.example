# Shared Neon DB (same instance as the middleware). Pull from Vercel:
#   vercel env pull .env.local
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth
JWT_SECRET=
MAGIC_LINK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OTP login email (Resend REST API)
RESEND_API_KEY=
# Must be a Resend-verified domain, e.g. "Stayable Locks <locks@rentstayable.com>".
# Falls back to onboarding@resend.dev (only delivers to the Resend account owner).
EMAIL_FROM=
