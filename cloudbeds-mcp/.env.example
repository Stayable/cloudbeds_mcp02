# Cloudbeds auth.
# Stayable's 8 properties are SEPARATE Cloudbeds accounts — set one self-service
# key per property, suffixed with the Cloudbeds property ID. Tool calls route to
# the key matching their propertyID argument.
#   CLOUDBEDS_API_KEY_5399=cbat_...   # Kissimmee West
#   CLOUDBEDS_API_KEY_812=cbat_...    # Jacksonville North
CLOUDBEDS_API_KEY_5399=

# Fallback for calls with no propertyID / no matching per-property key. Sent as x-api-key.
CLOUDBEDS_API_KEY=

# OAuth 2.0 bearer token (alternative single credential): sent as Authorization: Bearer.
CLOUDBEDS_ACCESS_TOKEN=

# API base URL. Default works for most accounts.
CLOUDBEDS_BASE_URL=https://api.cloudbeds.com/api/v1.2

# Set to "true" to enable write tools (post payment, notes, status changes).
# Leave unset/false for read-only operation.
CLOUDBEDS_ALLOW_WRITES=false
