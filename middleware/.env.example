# --- TTLock (one account, one "main" Application owns every lock) ---
# OAuth2 password grant. The password is MD5-hashed by the code at auth time;
# store the PLAINTEXT password here.
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=
TTLOCK_PASSWORD=
# EU API gateway. NOTE: this is euAPI (the API host), not euOPEN (the docs/portal
# where you registered the app — that host 404s on API calls). Override only for
# a non-EU account.
TTLOCK_BASE_URL=https://euapi.ttlock.com

# --- Cloudbeds webhook auth ---
# Cloudbeds does NOT HMAC-sign webhooks, so we gate the endpoint with a secret
# URL token instead. Register the webhook as:
#   POST /api/cloudbeds-webhook?token=<WEBHOOK_SECRET>
# and the handler verifies this token (constant-time) on every request.
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=

# --- Cloudbeds API keys (per-property: 8 separate accounts) ---
# The webhook payload has NO roomID, so the handler calls getReservation to find
# the assigned room(s). Each Stayable property is its own Cloudbeds account, so
# set ONE key per property, keyed by the REAL Cloudbeds propertyID:
#   CLOUDBEDS_API_KEY_206628=cbat_...   # Jacksonville North
#   CLOUDBEDS_API_KEY_210987=cbat_...   # Jacksonville West
#   CLOUDBEDS_API_KEY_210986=cbat_...   # Kissimmee East
#   CLOUDBEDS_API_KEY_210969=cbat_...   # Kissimmee West
#   CLOUDBEDS_API_KEY_210972=cbat_...   # Lakeland
#   CLOUDBEDS_API_KEY_210971=cbat_...   # Orlando OBT
#   CLOUDBEDS_API_KEY_208155=cbat_...   # St. Augustine
#   CLOUDBEDS_API_KEY_318197=cbat_...   # Davenport
# A bare CLOUDBEDS_API_KEY or CLOUDBEDS_ACCESS_TOKEN acts as a fallback/default.
CLOUDBEDS_ACCESS_TOKEN=

# --- Database (Phase 3) ---
# Neon Postgres connection string, shared with the lock-app project.
DATABASE_URL=
