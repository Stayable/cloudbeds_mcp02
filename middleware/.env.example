# --- TTLock (one account, one "main" Application owns every lock) ---
# OAuth2 password grant. The password is MD5-hashed by the code at auth time;
# store the PLAINTEXT password here.
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=
TTLOCK_PASSWORD=
# EU gateway. Override only if the account lives on another region.
TTLOCK_BASE_URL=https://euopen.ttlock.com

# --- Cloudbeds webhook auth ---
# HMAC shared secret; every inbound webhook must be signed with it (Phase 4).
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=

# Cloudbeds API token (for any callbacks the webhook handler needs to make).
CLOUDBEDS_ACCESS_TOKEN=

# --- Database (Phase 3) ---
# Neon Postgres connection string, shared with the lock-app project.
DATABASE_URL=
